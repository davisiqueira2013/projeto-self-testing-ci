# Caminho do banco SQLite. Use ":memory:" para banco em memória.
DATABASE_PATH=wallet.db
# Webhook do gateway anti-fraude fictício (vazio = notificações desativadas)
ANTIFRAUD_WEBHOOK_URL=https://antifraude.example.com/webhooks/transfers
ANTIFRAUD_TIMEOUT_SECONDS=2.0
# Transferências >= este valor (centavos) são sinalizadas como high_risk
HIGH_RISK_THRESHOLD_CENTS=500000
# Taxas de câmbio em relação ao BRL
FX_RATES_TO_BRL=USD=5.40,EUR=5.85
